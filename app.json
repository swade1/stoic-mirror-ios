{
  "expo": {
    "name": "The Stoic Mirror",
    "slug": "stoic-mirror",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/wreath.png",
    "scheme": "stoicmirror",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stoicmirror.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow The Stoic Mirror to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow The Stoic Mirror to use the microphone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/wreath.png",
        "backgroundColor": "#0f0e0c"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.stoicmirror.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/wreath.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#0f0e0c"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
